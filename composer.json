{
    "name": "handersonsilva/laravel-bruno-docs",
    "description": "Serve a Bruno collection as a Swagger UI page in Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "illuminate/contracts": "^13.0",
        "illuminate/pipeline": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Dotlib\\BrunoDocs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dotlib\\BrunoDocs\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Dotlib\\BrunoDocs\\BrunoDocsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
